.env
# `.env` is an exact match, so a hand-made backup beside it — `.env.bak-audit-…`
# — is untracked *and* stageable. One `git add -A` publishes every provider key.
.env.bak*
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Anchored to the repository root. Unanchored, `references/` also matched
# `skills/*/references/` and silently excluded the model-prompting and
# image-prompt-corrector reference libraries that the Skills tell an agent to
# read — they had never been committed.
/data/
/dist/
apps/web/dist/
/references/
/output/
.playwright-cli/
node_modules/
