DATABASE_URL=sqlite:///./data/platform.db
# Required by docker-compose.yml; generate a high-entropy value.
POSTGRES_PASSWORD=
STORAGE_ROOT=./data/media
STORAGE_BACKEND=local
MAX_UPLOAD_BYTES=104857600
MAX_UPLOAD_REQUEST_OVERHEAD_BYTES=65536
MAX_IMAGE_PIXELS=50000000
MAX_PROVIDER_DOWNLOAD_BYTES=104857600
PROVIDER_MEDIA_ALLOWED_HOSTS=google_flow=labs.google,*.googleusercontent.com,*.googleapis.com,*.googlevideo.com
# Alibaba Cloud OSS, Hong Kong, via its S3-compatible endpoint. Wan is an
# Alibaba service, so a bucket in the same cloud is the shortest fetch path for
# the reference URLs the provider resolves.
#   Region ID              cn-hongkong
#   S3-compatible endpoint https://s3.oss-cn-hongkong.aliyuncs.com
# Minimum RAM policy on acs:oss:*:*:<bucket>/* is two actions, not three:
# oss:PutObject and oss:GetObject. HeadObject and GetObjectMeta are both
# authorised by oss:GetObject; no separate oss:GetObjectMeta exists.
# The platform never deletes an object, so the service role needs no
# oss:DeleteObject — only the account running verify_object_storage.py does,
# and any future GC job. Keep the bucket private: every read is a short-lived
# presigned URL, never public-read.
# Verify before trusting it: uv run python scripts/verify_object_storage.py
S3_ENDPOINT_URL=https://s3.oss-cn-hongkong.aliyuncs.com
S3_REGION=cn-hongkong
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "virtual" for OSS, "path" for MinIO, "auto" to let boto3 guess.
S3_ADDRESSING_STYLE=virtual
# Bind x-amz-checksum-sha256 when the backend supports it. Alibaba OSS accepts
# this S3 header but does not enforce it, so production also verifies the full
# remote object before adopting a content-addressed key.
S3_ENFORCE_UPLOAD_CHECKSUM=true
S3_VERIFY_UPLOAD_SHA256_ON_COMPLETE=true
# Reference media is fetched by Seedance, Wan, OpenRouter and RunAPI themselves.
# They fetch from OBJECT STORAGE directly, using a short-lived presigned URL —
# this service is deliberately not in that path. A control plane that streams
# 4K reference plates is a control plane that falls over under a dozen
# concurrent edits. Configure S3_* below for any real deployment.
PUBLIC_BASE_URL=http://localhost:8080
# How long a provider-facing reference URL stays valid.
REFERENCE_URL_TTL_SECONDS=900
# Local disk cannot presign. Setting this enables a signed, expiring route on
# THIS service so local development can exercise reference edits — which means
# the API does proxy those bytes. Development affordance only: leave it empty in
# production and configure object storage instead.
# How long an authorized direct upload stays open (presigned PUT + quota hold).
DIRECT_UPLOAD_TTL_SECONDS=3600
# How often the worker reclaims uploads whose window closed without completing.
# The same sweep POST /internal/maintenance/expired-uploads runs on demand; this
# is what makes it a closed loop rather than an endpoint someone must remember.
# 0 disables it and leaves reclaiming to cron or an operator.
EXPIRED_UPLOAD_SWEEP_INTERVAL_SECONDS=300
EXPIRED_UPLOAD_SWEEP_LIMIT=200
LOCAL_REFERENCE_SIGNING_KEY=
MODEL_CONFIG_ROOT=./config/video-models
MODEL_INFRASTRUCTURE_CONFIG=./config/model-registry/defaults.json
FEATURE_VOYAGE_MEMORY=false
FEATURE_AUTO_EVALUATION=false
FEATURE_ADAPTIVE_ROUTER=false
# Conservative lower-confidence-bound routing. Do not switch on without a
# passing replay on file — see docs/ROUTER_EVIDENCE.md §8.
FEATURE_ROUTER_LCB=false
FEATURE_AUTO_RETRY=false
MEMORY_EMBEDDING_DIMENSION=512
MEMORY_MAX_CHARACTERS=12000
MEMORY_MAX_TOKENS=3000
MEMORY_MAX_IMAGES=8
MEMORY_MAX_VIDEOS=2
MAX_AUTO_RETRIES=2
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:18081
PLATFORM_API_KEY=
DEPLOYMENT_ENVIRONMENT=development
AUTH_REQUIRED=true
AUTH_SESSION_TTL_DAYS=30
CREDENTIAL_ENCRYPTION_KEY=
WORKER_CREDENTIAL_TTL_SECONDS=86400
WORKER_SOCKET_TICKET_TTL_SECONDS=60
WORKER_POLL_INTERVAL_SECONDS=1
GENERATION_POLL_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_TIMEOUT_SECONDS=30
GENERATION_CLAIM_LEASE_SECONDS=300
FLOW_API_BASE=https://aisandbox-pa.googleapis.com
FLOW_API_KEY=
FLOW_PROJECT_ID=
# Reviewed "model=runtime_key" pairs, comma separated; "{duration}" expands to the
# requested seconds (for example flow-veo-3.1=abra_veo31_{duration}s). Only the
# legacy "veo" alias ships with a reviewed key. An undeclared model is rejected
# instead of silently degrading to a text-to-video key.
FLOW_VIDEO_MODEL_KEYS=

# Provider transports remain network-free until all three live gates are set.
PROVIDER_MODE=mock
ALLOW_LIVE_PROVIDER_CALLS=false
LIVE_PROVIDER_CONFIRMATION=
PROVIDER_HTTP_TIMEOUT_SECONDS=120

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The project's image-generation model: POST {base}/images, text-to-image and
# image editing, up to 16 reference images and 10 images per request, 400K
# context. This is the IMAGE_GENERATION role's PRIMARY binding.
OPENROUTER_IMAGE_MODEL_ID=openai/gpt-image-2
# Optional extra "model=batch:references[:ratios]" envelopes, comma separated.
# The reviewed built-in table already covers openai/gpt-image-2; a model that is
# in neither table is rejected instead of submitted on guessed limits.
OPENROUTER_IMAGE_MODEL_KEYS=
# Layer 2 of the style lock: a multimodal embedding (google/gemini-embedding-2,
# through the OpenRouter credential above) that sees rendering medium,
# brushwork and photographic language — the things a colour/edge histogram
# cannot. Off by default: it is a paid call per locked style and per evaluated
# candidate, and it changes what "committable" means.
FEATURE_SEMANTIC_STYLE_LOCK=false

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL_ID=
SEEDANCE_MODEL_ID=

WAN_API_KEY=
WAN_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
WAN_DASHSCOPE_BASE_URL=
WAN_CHAT_MODEL_ID=qwen3.8-max
# Wan 2.7 is three DashScope models, one per generation mode. The mode is
# chosen from the request: a reference video selects r2v, a first frame selects
# i2v, and text alone selects t2v.
#   t2v  text, optionally images
#   i2v  images, optionally text and audio
#   r2v  image/video references plus text
WAN2_7_T2V_MODEL_ID=wan2.7-t2v-2026-06-12
WAN2_7_I2V_MODEL_ID=wan2.7-i2v-2026-04-25
WAN2_7_R2V_MODEL_ID=wan2.7-r2v-2026-06-12
# Reviewed "model[:mode]=dashscope_model" pairs, comma separated; modes are
# t2v, i2v, r2v. Built-in defaults cover all three wan-2.7 modes. Wan 3.0 is
# invitation-only Beta and has no reviewed runtime ID, so it fails closed until
# an invited operator declares one here, e.g. WAN_VIDEO_MODEL_KEYS=wan-3.0=<id>.
WAN_VIDEO_MODEL_KEYS=

RUNAPI_API_KEY=
RUNAPI_BASE_URL=
RUNAPI_MODEL_ID=
RUNAPI_CHAT_PATH=/v1/chat/completions
RUNAPI_IMAGE_PATH=/v1/images/generations
RUNAPI_VIDEO_PATH=/v1/videos
RUNAPI_BUDGET_USD=10
ALLOW_RUNAPI_EDGE_CALLS=false

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_ID=

# Alchemy Address Activity webhook for Native USDC on Base. Keep automatic
# credit posting disabled until wallet ownership verification is connected.
ALCHEMY_WEBHOOK_SIGNING_KEY=
ALCHEMY_WEBHOOK_ID=
ALCHEMY_NETWORK=BASE_MAINNET
ALCHEMY_TREASURY_ADDRESS=
ALCHEMY_CREDITING_ENABLED=false
ALCHEMY_USDC_MICROUNITS_PER_CREDIT=10000
REOWN_PROJECT_ID=
LEGACY_WALLET_PAYMENTS_ENABLED=false
WALLET_CHALLENGE_TTL_SECONDS=300
PAYMENT_INTENT_TTL_MINUTES=30

# Fixed 30 USDC DePay link (Base Mainnet, Native USDC, Quantity OFF). Every
# click creates a new server-side PaymentIntent and injects its order_ref.
# The public RSA key is issued by DePay after enabling the signed callback;
# keep it exact, using \n for PEM line breaks.
DEPAY_PAYMENT_LINK_URL=https://link.depay.com/4zFGRudwFRgMnZWD8bBwPF
DEPAY_LINK_ID=4zFGRudwFRgMnZWD8bBwPF
DEPAY_CALLBACK_PUBLIC_KEY=
DEPAY_CHECKOUT_TTL_MINUTES=1440
DEPAY_OFFER_AMOUNT_USDC=30
DEPAY_OFFER_CREDITS=3000
DEPAY_OFFER_UPGRADE_PLAN=PRO
