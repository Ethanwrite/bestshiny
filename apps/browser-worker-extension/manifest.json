{
  "manifest_version": 3,
  "name": "AI Video Platform Browser Worker",
  "version": "1.0.0",
  "description": "User-controlled browser worker for provider-backed video generation",
  "permissions": ["storage", "alarms", "tabs", "webRequest", "scripting"],
  "host_permissions": [
    "https://labs.google/*",
    "https://aisandbox-pa.googleapis.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://labs.google/fx/tools/flow*", "https://labs.google/fx/*/tools/flow*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["https://labs.google/*"]}],
  "action": {"default_popup": "popup.html", "default_title": "AI Video Worker"}
}

